[Unit]
Description=finalcheck bus board API (Node/Express)
After=network.target

[Service]
Type=simple
User=finalcheck
WorkingDirectory=/opt/finalcheck/server
EnvironmentFile=/opt/finalcheck/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
