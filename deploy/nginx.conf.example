# Copy to /etc/nginx/sites-available/finalcheck, adjust server_name, then:
#   ln -s /etc/nginx/sites-available/finalcheck /etc/nginx/sites-enabled/finalcheck
#   nginx -t && systemctl reload nginx
# Add HTTPS afterwards with: certbot --nginx -d your-domain.example

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.example;

    root /opt/finalcheck/client/dist;
    index index.html;

    # React SPA: any unknown path falls back to index.html
    location / {
        try_files $uri /index.html;
    }

    # Proxy API + SSE stream to the Node process
    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /api/events is a long-lived Server-Sent Events stream: disable
        # buffering and give it a long read timeout so it isn't cut off.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
