# Copy this file to .env and fill in real values before starting the server.

# Port the Node server listens on (put nginx or another reverse proxy in front of it).
PORT=4000

# Plain-text admin password used only once, at first boot, to seed the hash below.
# After the server has started once and written data/admin.json, you can remove this
# line -- the stored bcrypt hash is what's actually checked from then on.
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# Comma-separated list of origins allowed to call the API with credentials
# (your deployed frontend's URL). Example: https://board.example.com
CORS_ORIGIN=http://localhost:5173

# Set to "true" only once the site is served over HTTPS (a real domain + certbot).
# Leave "false" while serving over plain HTTP (e.g. a bare IP address) -- otherwise
# the browser silently drops the login session cookie and admin login never sticks.
COOKIE_SECURE=false
